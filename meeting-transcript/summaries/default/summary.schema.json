{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "meeting_sha256",
    "context",
    "summary",
    "key_points",
    "decisions",
    "entities",
    "links",
    "action_items",
    "open_questions",
    "verification",
    "transcript_findings",
    "reference_sources",
    "user_resolutions",
    "summarization_rules",
    "summarization_rule_suggestions"
  ],
  "properties": {
    "meeting_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context": {"type": "string"},
    "summary": {"type": "string"},
    "key_points": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "facts"],
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "facts": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "target"],
        "properties": {
          "label": {"type": "string"},
          "target": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "owner", "due_date", "status", "todoist_id", "todoist_url"],
        "properties": {
          "task": {"type": "string"},
          "owner": {"type": "string"},
          "due_date": {"type": "string"},
          "status": {"enum": ["open", "resolved", "skipped", "todoist_created"]},
          "todoist_id": {"type": "string"},
          "todoist_url": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "transcript_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_index", "category", "source_text", "interpretation", "status", "impact", "reference_path", "open_question", "user_resolution_index"],
        "properties": {
          "segment_index": {"type": "integer", "minimum": 0},
          "category": {"enum": ["entity", "speaker", "meaningful_garbage", "date_number_term"]},
          "source_text": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string"},
          "status": {"enum": ["reference_confirmed", "user_confirmed", "unresolved"]},
          "impact": {"type": "string", "minLength": 1},
          "reference_path": {"type": "string"},
          "open_question": {"type": "string"},
          "user_resolution_index": {"type": "integer", "minimum": -1}
        },
        "additionalProperties": false
      }
    },
    "reference_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "user_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer", "affected_field"],
        "properties": {
          "question": {"type": "string"},
          "answer": {"type": "string"},
          "affected_field": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "summarization_rules": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "summarization_rule_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposed_markdown", "rationale", "status", "resulting_sha256"],
        "properties": {
          "proposed_markdown": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "applied", "rejected"]},
          "resulting_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
