#!/bin/sh

set -u

module_name=$(basename "$0")
module_name=${module_name#audit-}
module_name=${module_name%.sh}

case "$module_name" in
  capabilities)
    printf '%s\n' '{"schema_version":"1","record_type":"capacity","module":"capabilities","status":"COMPLETE","path":"/TestVolume","total_bytes":1000,"used_bytes":500,"available_bytes":500,"sensitive":false}'
    printf '%s\n' '{"schema_version":"1","record_type":"module_status","module":"capabilities","status":"COMPLETE","evidence":"fixture complete"}'
    ;;
  paths)
    printf '%s\n' '{"schema_version":"1","record_type":"path","module":"paths","status":"MEASURED","path":"<home>","allocated_bytes":100,"logical_bytes":100,"sensitive":true}'
    if [ "${TEST_PATH_MODE:-complete}" = nonzero ]; then
      exit 3
    fi
    printf '%s\n' '{"schema_version":"1","record_type":"module_status","module":"paths","status":"COMPLETE","evidence":"fixture complete"}'
    ;;
  caches)
    printf '%s\n' '{"schema_version":"1","record_type":"cleanup_candidate","module":"caches","status":"MEASURED","path":"<home>/.cache/test","owner":"test","allocated_bytes":100,"logical_bytes":100,"classification":"APPROVAL-REQUIRED","proposed_action":"test cache clean","recovery":"rebuild","risk":"rebuild required","confidence":"high","actionable":true,"sensitive":true}'
    if [ "${TEST_CACHE_MODE:-complete}" = timeout ]; then
      sleep 5
      exit 0
    fi
    printf '%s\n' '{"schema_version":"1","record_type":"module_status","module":"caches","status":"COMPLETE","evidence":"fixture complete"}'
    ;;
  cloud)
    printf '%s\n' '{"schema_version":"1","record_type":"cloud_root","module":"cloud","status":"MEASURED","path":"~/Library/CloudStorage/<provider>","owner":"test-cloud","provider_kind":"test-cloud","domain_label":"test-cloud account 1","allocated_bytes":100,"logical_bytes":200,"sync_state":"unknown","local_state":"unknown","size_relation":"logical-greater-than-allocated","eviction_method":"unverified","classification":"AMBIGUOUS","proposed_action":"verify item-level state","recovery":"remote download if synced","risk":"remote deletion if wrong action is used","confidence":"low","sensitive":true}'
    printf '%s\n' '{"schema_version":"1","record_type":"module_status","module":"cloud","status":"PARTIAL","evidence":"item-level state unavailable"}'
    ;;
  *) exit 2 ;;
esac
